{
  "openapi": "3.0.3",
  "info": {
    "title": "Municipal Finance API",
    "description": "This API provides access to current and historical financial data from South African municipalities, enabling users to gather insights about municipal finances. It includes data sets covering various aspects of municipal financial performance and accountability, sourced from the National Treasury.",
    "version": "1.0.0",
    "contact": {
      "name": "OpenUp and National Treasury",
      "url": "https://municipaldata.treasury.gov.za/docs#general"
    },
    "termsOfService": "https://municipaldata.treasury.gov.za/docs#general"
  },
  "servers": [
    {
      "url": "https://municipaldata.treasury.gov.za/api",
      "description": "Production API Server"
    }
  ],
  "paths": {
    "/cubes/aged_creditor/facts": {
      "get": {
        "summary": "Get Aged Creditor Analysis",
        "description": "Analysis of creditors aggregated by age of debt. Does not include individual creditors. Submitted to National Treasury using return forms: AC, ACA.",
        "operationId": "getAgedCreditorAnalysis",
        "tags": [
          "Aged Creditor Analysis"
        ],
        "parameters": [
          {
            "name": "cut",
            "in": "query",
            "description": "Filter dimensions using pipe-separated dimension:value pairs",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "financial_year_end.year:2020|demarcation.code:CPT"
          },
          {
            "name": "drilldown",
            "in": "query",
            "description": "Dimensions to group by (pipe-separated)",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "item.code|financial_period.period"
          },
          {
            "name": "aggregates",
            "in": "query",
            "description": "Aggregation measures to return",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "amount.sum"
          },
          {
            "name": "order",
            "in": "query",
            "description": "Order results by specified field",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "financial_period.period:asc"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "Number of results per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with aged creditor data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgedCreditorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
